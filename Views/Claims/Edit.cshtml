@model cmcs_poe_part1.Models.Claim

<h1>Edit Claim</h1>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" for="Id" />
    <div class="form-group">
        <label for="NameSurname" class="control-label"></label>
        <input for="NameSurname" class="form-control" />
        <span validation-for="NameSurname" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Faculty" class="control-label"></label>
        <input for="Faculty" class="form-control" />
        <span validation-for="Faculty" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Role" class="control-label"></label>
        <input for="Role" class="form-control" />
        <span validation-for="Role" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Date" class="control-label"></label>
        <input for="Date" class="form-control" />
        <span validation-for="Date" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="HoursWorked" class="control-label"></label>
        <input for="HoursWorked" class="form-control" />
        <span validation-for="HoursWorked" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="HourlyRate" class="control-label"></label>
        <input for="HourlyRate" class="form-control" />
        <span validation-for="HourlyRate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="SupportingDocuments" class="control-label"></label>
        <input for="SupportingDocuments" class="form-control" />
        <span validation-for="SupportingDocuments" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Amount" class="control-label"></label>
        <input for="Amount" class="form-control" />
        <span validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>