@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="dashboard">
    <h1>Welcome to XolozyClaims</h1>
    <!-- Navigation buttons inside header -->
    <div class="nav-buttons">
        <h1> XolozyClaims</h1>

        <a class="btn" href="@Url.Action("Index","Home")">Home</a>
        <a class="btn" href="@Url.Action("Dashboard","Home")">About</a>
        <a class="btn" href="@Url.Action("Claims","Home")">Claims</a>
        <a class="btn" href="@Url.Action("trackclaims","Home")">Track Claims</a>
        <a class="btn" href="@Url.Action("ClaimReport","Home")">Pre-approval</a>
        <a class="btn" href="@Url.Action("finalClaimApproval","Home")">Approval</a>
    </div>
</div>

<p> Before submitting a new claim, please make sure that all details you provide are accurate and complete.</p>
<p> Enter your full name, faculty, and role correctly, and ensure that the date and claim amount are valid.</p>
<p> Incomplete or incorrect claims may delay processing.</p>
<p>Please remember that all claims will first be reviewed by your Program Coordinator for pre-approval, after which they will be formally approved or rejected by your Program Manager.</p>
<p> Providing accurate information will help your claim move smoothly through the approval process.</p>


<div class="container">
    <div class="form-box">
        <form method="post" action="/Home/trackclaims" >
            <div>
                <label for="NameSurname">Name and Surname:</label>
                <input id="NameSurname" name="NameSurname" type="text" required />
            </div>
            <div>
                <label for="Faculty">Faculty:</label>
                <input id="Faculty" name="Faculty" type="text" required />
            </div>
            <div>
                <label for="Role">Role:</label>
                <select id="Role" name="Role" required>
                    <option>Select a role</option>
                    <option>Lecture</option>
                    <option>project cordinator</option>
                    <option>academic menanger</option>
                </select>
            </div>
            <div>
                <label for="Date">Date:</label>
                <input id="Date" name="Date" type="date" required />
            </div>
            <div>
                <label for="HoursWorked">Hours Worked:</label>
                <input id="HoursWorked" name="HoursWorked" type="number" min="0" step="1" required />
            </div>
            <div>
                <label for="HourlyRate">Hourly Rate:</label>
                <input id="HourlyRate" name="HourlyRate" type="number" min="0" step="1" required />
            </div>
            <div>
                <label for="SupportingDocuments">Upload Supporting Documents:</label>
                <input id="SupportingDocuments" name="documents" type="file" multiple required accept=".pdf,.docx,.xlsx" onchange="checkFileSize(this)" />
                <span id="fileSizeError" style="color: red; display: none;">File size exceeds 500MB limit.</span>
            </div>
            <div>
                <label for="Amount">Amount:</label>
                <input id="Amount" name="Amount" type="number" required />
            </div>
            <div>
                <label for="WouldYouLikeToaddSomething">WouldYouLikeToaddSomething:</label>
                <input id="WouldYouLikeToaddSomething" name="WouldYouLikeToaddSomething" type="text" />
            </div>
            <div>
                <label for="Status">Status:</label>
                <input id="Status" name="Status" type="text" />
            </div>
            <button type="submit">Submit</button>
        </form>
    </div>
</div>

<script>
    function checkFileSize(input) {
        const fileSizeError = document.getElementById('fileSizeError');
        const files = input.files;
        let totalSize = 0;
        for (let i = 0; i < files.length; i++) {
            totalSize += files[i].size;
        }
        if (totalSize > 500 * 1024 * 1024) {
            fileSizeError.style.display = 'block';
            input.value = '';
        } else {
            fileSizeError.style.display = 'none';
        }
    }
</script>