@{
    ViewData["Title"] = "Home Page";
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

   

<div class="index-image">
    <img src="@Url.Content("~/images/image_2.jpg")" alt="Description" />

</div>
<div class="container">
    <div class="form-box">


        <h1 style="color: lightseagreen">Login or create a new account</h1>

        <form method="post" action="/Home/Dashboard">
            <div>
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" req />
            </div>

            <div>
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" />
            </div>
            <div>
                <select>
                    <option>Please provide a role</option>
                    <option>Lecturer</option>
                    <option>Program codinator </option>
                    <option>Program manager</option>
                </select>

            </div>
            <button type="submit">Login</button>
        </form>

        <p>
            Don’t have an account?
            <a href="@Url.Action("Register", "Home")">Register</a>
        </p>
    </div>
</div>




