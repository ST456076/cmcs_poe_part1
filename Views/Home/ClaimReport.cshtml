<tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var claim in Model)
        {
            <tr>
                <td>@claim.LecturerName</td>
                <td>@claim.HoursWorked</td>
                <td>@claim.HourlyRate</td>
                <td>@claim.Total</td>
                <td>@claim.Status</td>
                <td>
                    <form asp-action="Approve" asp-route-id="@claim.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-success">Approve</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@claim.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </form>
                </td>
            </tr>
        }

        <!-- closing foreach -->
    }
  <!-- closing if -->
    else
    {
    <tr>
        <td colspan="6">No claims found.</td>
    </tr>
    }
    else if {
    <p>

        <a class="btn-add-claim" href="@Url.Action("trackclaims", "Home")">Pre-approve</a>
    </p>
   
    }
</tbody>
