@model IEnumerable<cmcs_poe_part1.Models.LectureClaims>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Faculty</th>
            <th>Date</th>
            <th>Hours</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.NameSurname ?? "N/A")</td>
                    <td>@(item.Faculty ?? "N/A")</td>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.HoursWorked</td>
                    <td>
                        @if (item.Status?.Trim() == "Pending")
                        {
                            <span class="btn btn-primary btn-sm">Pending</span>
                        }
                        else if (item.Status?.Trim() == "Pre-Approved")
                        {
                            <span class="btn btn-success btn-sm">Pre-Approved</span>
                        }
                        else if (item.Status?.Trim() == "Declined")
                        {
                            <span class="btn btn-danger btn-sm">Declined</span>
                        }
                        else
                        {
                            <span class="btn btn-secondary btn-sm">Unknown</span>
                        }
                    </td>
                    <td>
                        @if (User.IsInRole("ProgramCoordinator") && item.Status?.Trim() == "Pending")
                        {
                            <form method="post" asp-action="PreApprove" asp-route-id="@item.Id" style="display:inline">
                                <button class="btn btn-success btn-sm">Pre-Approve</button>
                            </form>
                            <form method="post" asp-action="Decline" asp-route-id="@item.Id" style="display:inline">
                                <button class="btn btn-danger btn-sm">Decline</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">No claims to display.</td>
            </tr>
        }
    </tbody>
</table>

