@model IEnumerable<cmcs_poe_part1.Models.LectureClaims>

<h2>Programme Coordinator – Claim Review</h2>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Hours</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>

    @foreach (var claim in Model)
    {
        <tr>
            <td>@claim.NameSurname</td>
            <td>@claim.HoursWorked</td>
            <td>@claim.Status</td>
            <td>
                <form asp-controller="PreApproveClaim" asp-action="PreApprove" method="post" style="display:inline-block;">
                    <input type="hidden" name="id" value="@claim.Id" />
                    <button class="btn btn-warning btn-sm">Pre-Approve</button>
                </form>
                <form asp-controller="PreApproveClaim" asp-action="Decline" method="post" style="display:inline-block;">
                    <input type="hidden" name="id" value="@claim.Id" />
                    <button class="btn btn-danger btn-sm">Decline</button>
                </form>
            </td>
        </tr>
    }
</table>


