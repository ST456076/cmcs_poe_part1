@model cmcs_poe_part1.Models.LectureClaims

@{
    ViewData["Title"] = "Create";
}


<div class="dashboard">
    <h1>Lecturer Dashboard</h1>
    <!-- Navigation buttons inside header -->
    <div class="nav-buttons">
        <a class="btn" href="@Url.Action("Index", "Home")">Home</a>
        <a class="btn" href="@Url.Action("LecturerDashboard", "Home")">Dashboard</a>
        <a class="btn" href="@Url.Action("trackclaims", "Home")">Track Claims</a>
    </div>
</div>


<h1>Create Claim</h1>
       
<p> Before submitting a new claim, please make sure that all details you provide are accurate and complete.</p>
<p> Enter your full name, faculty, and role correctly, and ensure that the date and claim amount are valid.</p>
<p> Incomplete or incorrect claims may delay processing.</p>
<p>Please remember that all claims will first be reviewed by your Program Coordinator for pre-approval, after which they will be formally approved or rejected by your Program Manager.</p>
<p> Providing accurate information will help your claim move smoothly through the approval process.</p>

<hr />
<div class="container">
    <div class="form-box">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NameSurname" class="control-label"></label>
                <input asp-for="NameSurname" class="form-control" />
                <span asp-validation-for="NameSurname" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Faculty" class="control-label"></label>
                <input asp-for="Faculty" class="form-control" />
                <span asp-validation-for="Faculty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HoursWorked" class="control-label"></label>
                <input asp-for="HoursWorked" class="form-control" />
                <span asp-validation-for="HoursWorked" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HourlyRate" class="control-label"></label>
                <input asp-for="HourlyRate" class="form-control" />
                <span asp-validation-for="HourlyRate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SupportingDocuments" class="control-label"></label>
                <input asp-for="SupportingDocuments" class="form-control" type="file" />
                <span asp-validation-for="SupportingDocuments" class="text-danger"></span>
            </div>
          
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WouldYouLikeToaddSomething" class="control-label"></label>
                <input asp-for="WouldYouLikeToaddSomething" class="form-control" />
                <span asp-validation-for="WouldYouLikeToaddSomething" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


