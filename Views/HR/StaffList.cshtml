@model IEnumerable<cmcs_poe_part1.Models.LectureClaims>

<h1>Staff List</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Faculty</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var staff in Model)
        {
            <tr>
                <td>@staff.Name</td>
                <td>@staff.Faculty</td>
            </tr>
        }
    </tbody>
</table>

