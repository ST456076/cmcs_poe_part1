@{
    ViewData["Title"] = "HR Dashboard";
}
@model dynamic


<div class="dashboard">
    <h1>HR Dashboard</h1>    <!-- Navigation buttons inside header -->
    <div class="nav-buttons">
        <a class="btn" href="@Url.Action("Index", "Home")">Home</a>
        <a class="btn" href="@Url.Action("LecturerDashboard", "Home")">Dashboard</a>
        <a class="btn" href="@Url.Action("trackclaims", "Home")">Track Claims</a>
    </div>
</div>
<h1>Welcome to the HR Dashboard</h1>
<h2>Claims</h2>
<ul>
    @foreach (var claim in Model.Claims)
    {
        <li>@claim.Id - @claim.Status</li>
    }
</ul>

<h2>Lecturers</h2>
<ul>
    @foreach (var lecturer in Model.Lecturers)
    {
        <li>@lecturer.Name - @lecturer.Faculty</li>
    }
</ul>